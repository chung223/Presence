{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ 已恢復自動鎖定與解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resumed automatic lock and unlock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢復自動鎖定與解鎖"
          }
        }
      }
    },
    "%@ 已暫停自動鎖定與解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paused automatic lock and unlock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暫停自動鎖定與解鎖"
          }
        }
      }
    },
    "%@ 已鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is locked"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已鎖定"
          }
        }
      }
    },
    "%@前更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated %@ ago"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前更新"
          }
        }
      }
    },
    "Mac 已鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Locked"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已鎖定"
          }
        }
      }
    },
    "Mac 狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Status"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 狀態"
          }
        }
      }
    },
    "先在 App 配對 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a Mac in the app first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在 App 配對 Mac"
          }
        }
      }
    },
    "分鐘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分鐘"
          }
        }
      }
    },
    "取得 Mac 狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Mac Status"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得 Mac 狀態"
          }
        }
      }
    },
    "回傳 Presence 目前的狀態，例如「Weichung 在附近」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns the current status of Presence, such as “iPhone nearby”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳 Presence 目前的狀態，例如「Weichung 在附近」。"
          }
        }
      }
    },
    "在指定的時間內，電腦不會自動鎖定也不會自動解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the given time, your computer won't lock or unlock automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定的時間內，電腦不會自動鎖定也不會自動解鎖。"
          }
        }
      }
    },
    "已鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已鎖定"
          }
        }
      }
    },
    "恢復": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復"
          }
        }
      }
    },
    "恢復 Presence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Presence"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復 Presence"
          }
        }
      }
    },
    "打開後一小時內，Mac 不會自動鎖定也不會自動解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, your Mac won't lock or unlock automatically for one hour."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開後一小時內，Mac 不會自動鎖定也不會自動解鎖。"
          }
        }
      }
    },
    "暫停": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停"
          }
        }
      }
    },
    "暫停 1 小時": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause 1 Hour"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 1 小時"
          }
        }
      }
    },
    "暫停 Presence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Presence"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 Presence"
          }
        }
      }
    },
    "暫停 Presence ${minutes} 分鐘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Presence for ${minutes} minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 Presence ${minutes} 分鐘"
          }
        }
      }
    },
    "暫停到 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused until %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停到 %@"
          }
        }
      }
    },
    "暫停或恢復 Presence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or Resume Presence"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停或恢復 Presence"
          }
        }
      }
    },
    "未連線 · %@前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected · %@ ago"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連線 · %@前"
          }
        }
      }
    },
    "用 Presence 立即鎖定配對的 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock your paired Mac now with Presence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Presence 立即鎖定配對的 Mac。"
          }
        }
      }
    },
    "用 Presence 立即鎖定配對的電腦。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock your paired computer now with Presence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Presence 立即鎖定配對的電腦。"
          }
        }
      }
    },
    "看 Presence 目前的狀態，一鍵鎖定 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the current status of Presence and lock your Mac with one tap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看 Presence 目前的狀態，一鍵鎖定 Mac。"
          }
        }
      }
    },
    "結束暫停，恢復自動鎖定與解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the pause and resume automatic lock and unlock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束暫停，恢復自動鎖定與解鎖。"
          }
        }
      }
    },
    "自動鎖定中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto Lock On"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動鎖定中"
          }
        }
      }
    },
    "請打開 Presence Remote 再試一次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Presence Remote and try again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請打開 Presence Remote 再試一次"
          }
        }
      }
    },
    "還沒有狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No status yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有狀態"
          }
        }
      }
    },
    "鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定"
          }
        }
      }
    },
    "鎖定 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 Mac"
          }
        }
      }
    }
  },
  "version": "1.0"
}
