    "%@ 已恢復自動鎖定與解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat automatisches Sperren und Entsperren fortgesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resumed automatic lock and unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha reanudado el bloqueo y desbloqueo automáticos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : reprise du verrouillage et déverrouillage auto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の自動ロックとロック解除を再開しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 자동 잠금 및 잠금 해제 재개됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复自动锁定与解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢復自動鎖定與解鎖"
          }
        }
      }
    },
    "%@ 已暫停自動鎖定與解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat automatisches Sperren und Entsperren pausiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paused automatic lock and unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha pausado el bloqueo y desbloqueo automáticos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : verrouillage et déverrouillage auto suspendus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の自動ロックとロック解除を一時停止しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 자동 잠금 및 잠금 해제 일시 정지됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暂停自动锁定与解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暫停自動鎖定與解鎖"
          }
        }
      }
    },
