    "打開後一小時內，Mac 不會自動鎖定也不會自動解鎖。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, wird der Mac eine Stunde lang weder automatisch gesperrt noch entsperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, your Mac won't lock or unlock automatically for one hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, el Mac no se bloqueará ni se desbloqueará automáticamente durante una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, le Mac ne se verrouille ni ne se déverrouille automatiquement pendant une heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、1時間はMacが自動ロックも自動ロック解除もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
