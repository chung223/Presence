{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "%@前更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated %@ ago"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前更新"
          }
        }
      }
    },
    "Mac 最前面是「%@」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is in front on your Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 最前面是「%@」"
          }
        }
      }
    },
    "Presence Pro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence Pro"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence Pro"
          }
        }
      }
    },
    "上一頁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一頁"
          }
        }
      }
    },
    "下一頁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一頁"
          }
        }
      }
    },
    "尚未取得狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No status yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得狀態"
          }
        }
      }
    },
    "恢復": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復"
          }
        }
      }
    },
    "暫停 1 小時": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause 1 Hour"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 1 小時"
          }
        }
      }
    },
    "暫停 15 分鐘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause 15 Minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停 15 分鐘"
          }
        }
      }
    },
    "用手錶翻頁、轉錶冠或兩指互點，是 Presence Pro 的功能。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing slides from your watch—by tapping, turning the Digital Crown, or double tapping—is part of Presence Pro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手錶翻頁、轉錶冠或兩指互點，是 Presence Pro 的功能。"
          }
        }
      }
    },
    "直接連線": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct connection"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線"
          }
        }
      }
    },
    "簡報": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slides"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡報"
          }
        }
      }
    },
    "經由 iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經由 iPhone"
          }
        }
      }
    },
    "請先在 iPhone 的 Presence Remote 配對 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a Mac in Presence Remote on your iPhone first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iPhone 的 Presence Remote 配對 Mac"
          }
        }
      }
    },
    "請先在 iPhone 的 Presence Remote 配對 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a Mac in Presence Remote on your iPhone first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iPhone 的 Presence Remote 配對 Mac。"
          }
        }
      }
    },
    "請在 iPhone 的 Presence Remote 點「簡報遙控」升級，手錶會自動開通。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade by tapping Presenter Remote in Presence Remote on your iPhone. Your watch will be unlocked automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 的 Presence Remote 點「簡報遙控」升級，手錶會自動開通。"
          }
        }
      }
    },
    "鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定"
          }
        }
      }
    }
  },
  "version": "1.0"
}
