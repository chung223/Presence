    "用手錶翻頁、轉錶冠或兩指互點，是 Presence Pro 的功能。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folien auf der Uhr wechseln – per Tippen, Digital Crown oder Doppeltippen – ist Teil von Presence Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing slides from your watch—by tapping, turning the Digital Crown, or double tapping—is part of Presence Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar diapositivas desde el reloj (tocando, girando la Digital Crown o con doble toque) es una función de Presence Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de diapositive depuis la montre (toucher, Digital Crown ou Toucher deux fois) fait partie de Presence Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchでのスライド操作（タップ、Digital Crown、ダブルタップ）はPresence Proの機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch로 슬라이드 넘기기(탭, Digital Crown 돌리기, 이중 탭)는 Presence Pro 기능입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手表翻页、转动数码表冠或互点两下，是 Presence Pro 的功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手錶翻頁、轉錶冠或兩指互點，是 Presence Pro 的功能。"
          }
        }
      }
    },
