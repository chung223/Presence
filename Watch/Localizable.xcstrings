    "Mac 現在的聲音輸出不能從這裡調音量": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke der aktuellen Tonausgabe des Mac lässt sich hier nicht ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume of your Mac’s current sound output can’t be changed here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de la salida de sonido actual del Mac no se puede ajustar desde aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume de la sortie audio actuelle du Mac ne peut pas être réglé ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの現在のサウンド出力は、ここから音量を調整できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 현재 사운드 출력은 여기에서 음량을 조절할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 当前的声音输出无法在这里调节音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 現在的聲音輸出不能從這裡調音量"
          }
        }
      }
    },
