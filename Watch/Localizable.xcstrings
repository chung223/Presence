    "請先在 iPhone 的 Presence Remote 配對 Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple zuerst einen Mac in Presence Remote auf dem iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a Mac in Presence Remote on your iPhone first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaza un Mac en Presence Remote en el iPhone"
          }
        },
        "fr": {
