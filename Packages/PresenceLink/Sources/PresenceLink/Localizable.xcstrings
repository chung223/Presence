{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "Mac 上的 Presence 沒有輔助使用權限，不能翻頁": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence auf dem Mac hat keinen Zugriff auf die Bedienungshilfen und kann keine Folien wechseln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence on your Mac doesn't have Accessibility permission, so it can't change slides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence en el Mac no tiene permiso de Accesibilidad y no puede pasar diapositivas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence sur le Mac n’a pas l’autorisation Accessibilité et ne peut pas changer de diapositive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのPresenceにアクセシビリティの許可がないため、スライドをめくれません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Presence에 손쉬운 사용 권한이 없어 슬라이드를 넘길 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上的 Presence 没有辅助功能权限，无法翻页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上的 Presence 沒有輔助使用權限，不能翻頁"
          }
        }
      }
    },
    "Mac 沒有接受這個指令": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac hat den Befehl nicht angenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac didn't accept this command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no ha aceptado este comando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a refusé cette commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがこのコマンドを受け付けませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 이 명령을 수락하지 않았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 未接受这条指令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 沒有接受這個指令"
          }
        }
      }
    },
    "Mac 螢幕鎖著，先解鎖才能翻頁": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac ist gesperrt. Entsperre ihn, um Folien zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is locked. Unlock it to change slides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac está bloqueado. Desbloquéalo para pasar diapositivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac est verrouillé. Déverrouillez-le pour changer de diapositive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがロックされています。ロックを解除するとスライドをめくれます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 화면이 잠겨 있습니다. 잠금을 해제해야 슬라이드를 넘길 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 屏幕已锁定，请先解锁再翻页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 螢幕鎖著，先解鎖才能翻頁"
          }
        }
      }
    },
    "尚未配對": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gekoppelt"
          }
        },
        "en": {
