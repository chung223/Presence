{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "%@ 在附近%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in der Nähe%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cerca%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à proximité%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が近くにあります%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 근처에 있음%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近%2$@"
          }
        }
      }
    },
    "%@，暫停自動鎖定": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – automatisches Sperren pausiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — auto-lock paused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bloqueo automático en pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — verrouillage auto suspendu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のため、自動ロックを一時停止中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 자동 잠금 일시 정지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暂停自动锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暫停自動鎖定"
          }
        }
      }
    },
    "%@，暫停自動鎖定與解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – automatisches Sperren und Entsperren pausiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — auto-lock and unlock paused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bloqueo y desbloqueo automáticos en pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — verrouillage et déverrouillage auto suspendus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のため、自動ロックとロック解除を一時停止中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 자동 잠금 및 잠금 해제 일시 정지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暂停自动锁定与解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暫停自動鎖定與解鎖"
          }
        }
      }
    },
