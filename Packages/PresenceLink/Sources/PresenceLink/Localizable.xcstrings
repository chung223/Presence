    "正在尋找 Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wird gesucht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando el Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche du Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macを探しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 찾는 중"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找 Mac"
          }
        }
      }
    },
    "沒有藍牙權限": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bluetooth-Zugriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bluetooth permission"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso de Bluetooth"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au Bluetooth"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothの許可がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 권한 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有蓝牙权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有藍牙權限"
          }
        }
      }
    },
    "簡報遙控是 Presence Pro 的功能，請在 iPhone 的 Presence Remote 升級": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Präsentationssteuerung ist Teil von Presence Pro. Das Upgrade gibt es in Presence Remote auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenter Remote is part of Presence Pro. Upgrade in Presence Remote on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mando de presentaciones es una función de Presence Pro. Pásate a Pro en Presence Remote en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télécommande de présentation fait partie de Presence Pro. Passez à Presence Pro dans Presence Remote sur l’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンリモコンはPresence Proの機能です。iPhoneのPresence Remoteでアップグレードしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션 리모컨은 Presence Pro 기능입니다. iPhone의 Presence Remote에서 업그레이드하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示遥控是 Presence Pro 的功能，请在 iPhone 上的 Presence Remote 中升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡報遙控是 Presence Pro 的功能，請在 iPhone 的 Presence Remote 升級"
          }
        }
      }
    },
    "藍牙沒有開啟": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth est désactivé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオフです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth가 꺼져 있음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙未打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙沒有開啟"
          }
        }
      }
    },
    "請在 Mac 的 Presence 打開「手機與手錶 › 允許簡報遙控」": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in Presence auf dem Mac „iPhone & Watch › Präsentationssteuerung erlauben“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Presence on your Mac, turn on iPhone & Watch › Allow Presenter Remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Presence en el Mac, activa “iPhone y Watch › Permitir mando de presentaciones”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Presence sur le Mac, activez « iPhone et montre › Autoriser la télécommande de présentation »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのPresenceで「iPhoneとWatch › プレゼンリモコンを許可」をオンにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Presence에서 ‘iPhone 및 Watch › 프레젠테이션 리모컨 허용’을 켜세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上的 Presence 中打开“手机与手表 › 允许演示遥控”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Mac 的 Presence 打開「手機與手錶 › 允許簡報遙控」"
          }
        }
      }
    },
    "連不上 Mac，請確認 Mac 在附近、Presence 正在執行": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nicht erreichbar. Stelle sicher, dass er in der Nähe ist und Presence läuft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Mac. Make sure it's nearby and Presence is running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el Mac. Comprueba que esté cerca y que Presence esté abierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le Mac. Vérifiez qu’il est à proximité et que Presence est ouvert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに接続できません。Macが近くにあり、Presenceが実行中か確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 연결할 수 없습니다. Mac이 근처에 있고 Presence가 실행 중인지 확인하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Mac，请确认 Mac 在附近且 Presence 正在运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上 Mac，請確認 Mac 在附近、Presence 正在執行"
          }
        }
      }
    },
