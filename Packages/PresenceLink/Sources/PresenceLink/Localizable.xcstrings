    "偵測到你還在操作，暫緩鎖定": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt den Mac noch – Sperre aufgeschoben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're still using the Mac — lock postponed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigues usando el Mac: bloqueo aplazado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez encore le Mac — verrouillage différé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作中のためロックを保留中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 사용 중이어서 잠금 보류"
