{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "Mac 沒有接受這個指令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac didn't accept this command"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 沒有接受這個指令"
          }
        }
      }
    },
    "尚未配對": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配對"
          }
        }
      }
    },
    "已連線": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        }
      }
    },
    "未連線": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連線"
          }
        }
      }
    },
    "正在尋找 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找 Mac"
          }
        }
      }
    },
    "沒有藍牙權限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bluetooth permission"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有藍牙權限"
          }
        }
      }
    },
    "藍牙沒有開啟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙沒有開啟"
          }
        }
      }
    },
    "連不上 Mac，請確認 Mac 在附近、Presence 正在執行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Mac. Make sure it's nearby and Presence is running"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上 Mac，請確認 Mac 在附近、Presence 正在執行"
          }
        }
      }
    },
    "連線中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中"
          }
        }
      }
    },
    "還沒有配對 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac paired yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有配對 Mac"
          }
        }
      }
    }
  },
  "version": "1.0"
