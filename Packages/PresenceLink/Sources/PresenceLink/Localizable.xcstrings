{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "Mac 上的 Presence 沒有輔助使用權限，不能翻頁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence on your Mac doesn't have Accessibility permission, so it can't change slides."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上的 Presence 沒有輔助使用權限，不能翻頁"
          }
        }
      }
    },
    "Mac 沒有接受這個指令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac didn't accept this command"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 沒有接受這個指令"
          }
        }
      }
    },
    "Mac 螢幕鎖著，先解鎖才能翻頁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is locked. Unlock it to change slides."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 螢幕鎖著，先解鎖才能翻頁"
          }
        }
      }
    },
    "尚未配對": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配對"
          }
        }
      }
    },
    "已連線": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        }
      }
    },
    "未連線": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連線"
          }
        }
      }
    },
    "正在尋找 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找 Mac"
          }
        }
      }
    },
    "沒有藍牙權限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bluetooth permission"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有藍牙權限"
          }
        }
      }
    },
    "簡報遙控是 Presence Pro 的功能，請在 iPhone 的 Presence Remote 升級": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenter Remote is part of Presence Pro. Upgrade in Presence Remote on your iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡報遙控是 Presence Pro 的功能，請在 iPhone 的 Presence Remote 升級"
          }
        }
      }
    },
    "藍牙沒有開啟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙沒有開啟"
          }
        }
      }
    },
    "請在 Mac 的 Presence 打開「手機與手錶 › 允許簡報遙控」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Presence on your Mac, turn on iPhone & Watch › Allow Presenter Remote."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Mac 的 Presence 打開「手機與手錶 › 允許簡報遙控」"
          }
        }
      }
    },
    "連不上 Mac，請確認 Mac 在附近、Presence 正在執行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Mac. Make sure it's nearby and Presence is running"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上 Mac，請確認 Mac 在附近、Presence 正在執行"
          }
        }
      }
    },
    "連線中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中"
          }
        }
      }
    },
    "還沒有配對 Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac paired yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有配對 Mac"
          }
        }
      }
    }
  },
  "version": "1.0"
}
