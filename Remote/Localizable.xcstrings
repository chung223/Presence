            "value": "簡報遙控"
          }
        }
      }
    },
    "結束播放": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Show"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束播放"
          }
        }
      }
    },
    "結束暫停，恢復自動鎖定與解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the pause and resume automatic lock and unlock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束暫停，恢復自動鎖定與解鎖。"
          }
        }
      }
    },
    "結束簡報": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Presentation"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束簡報"
          }
        }
      }
    },
    "結束簡報遙控，電腦恢復自動鎖定與解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the presenter remote so your computer locks and unlocks automatically again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束簡報遙控，電腦恢復自動鎖定與解鎖。"
          }
        }
      }
    },
    "要取消與這台 Mac 的配對嗎？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpair from this Mac?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消與這台 Mac 的配對嗎？"
          }
        }
      }
    },
    "設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "請把 Mac 上的 Presence 更新到最新版，才能簡報遙控": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Presence on your Mac to the latest version to use the presenter remote."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請把 Mac 上的 Presence 更新到最新版，才能簡報遙控"
          }
        }
      }
    },
    "讓電腦上的簡報回到上一頁。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes back one slide in the presentation on your computer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓電腦上的簡報回到上一頁。"
          }
        }
      }
    },
    "讓電腦上的簡報翻到下一頁。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advances the presentation on your computer to the next slide."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓電腦上的簡報翻到下一頁。"
          }
        }
      }
    },
    "這不是 Presence 的配對 QR code。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a Presence pairing QR code."
          }
        },
