    "結束簡報遙控，電腦恢復自動鎖定與解鎖。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die Präsentationssteuerung, damit der Computer wieder automatisch sperrt und entsperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the presenter remote so your computer locks and unlocks automatically again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el mando de presentaciones para que el ordenador vuelva a bloquearse y desbloquearse automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la télécommande de présentation : l’ordinateur se verrouille et se déverrouille de nouveau automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンリモコンを終了し、コンピュータの自動ロックとロック解除を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션 리모컨을 종료하고 컴퓨터의 자동 잠금 및 잠금 해제를 재개합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束演示遥控，电脑恢复自动锁定与解锁。"
