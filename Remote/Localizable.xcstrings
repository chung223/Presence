            "value": "Apple Watchもプレゼンリモコンに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch도 프레젠터가 됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 也是翻页笔"
