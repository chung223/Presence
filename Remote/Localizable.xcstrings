    "簡報中暫停自動鎖定，結束後恢復": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Sperren pausiert während des Vortrags und läuft danach weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock pauses during your talk and resumes afterward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo automático se pausa durante la charla y se reanuda al terminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage auto est suspendu pendant la présentation, puis reprend"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼン中は自動ロックを一時停止し、終了後に再開"
