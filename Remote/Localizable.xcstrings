            "state": "translated",
            "value": "名稱"
          }
        }
      }
    },
    "回傳 Presence 目前的狀態，例如「Weichung 在附近」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns the current status of Presence, such as “iPhone nearby”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳 Presence 目前的狀態，例如「Weichung 在附近」。"
          }
        }
      }
    },
    "回到這裡，點「簡報遙控」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here and tap Presenter Remote"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到這裡，點「簡報遙控」"
          }
        }
      }
    },
    "在 Mac 打開 Presence，到「手機與手錶」按「配對新的 iPhone」": {
      "localizations": {
        "en": {
