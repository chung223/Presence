      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to your Mac…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連線到 Mac…"
          }
        }
      }
    },
    "用 Presence 立即鎖定配對的電腦。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock your paired computer now with Presence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Presence 立即鎖定配對的電腦。"
          }
