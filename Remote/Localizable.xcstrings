    "%lld 天後每年 %@，自動續訂，可隨時取消": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %1$lld Tagen %2$@ pro Jahr, verlängert sich automatisch, jederzeit kündbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ per year after %1$lld days. Renews automatically; cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ al año tras %1$lld días. Se renueva automáticamente; cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ par an après %1$lld jours. Renouvellement automatique, annulable à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld日後から年額%2$@。自動更新、いつでもキャンセルできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld일 후 매년 %2$@, 자동 갱신되며 언제든지 취소 가능"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 天后每年 %2$@，自动续期，可随时取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 天後每年 %2$@，自動續訂，可隨時取消"
          }
        }
      }
    },
