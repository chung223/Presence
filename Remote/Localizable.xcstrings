          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Presence auf dem Mac auf die neueste Version, um die Präsentationssteuerung zu nutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Presence on your Mac to the latest version to use the presenter remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Presence en el Mac a la última versión para usar el mando de presentaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Presence sur votre Mac pour utiliser la télécommande de présentation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンリモコンを使うには、MacのPresenceを最新版にアップデートしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션 리모컨을 사용하려면 Mac의 Presence를 최신 버전으로 업데이트하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
