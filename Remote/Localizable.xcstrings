    "回傳 Presence 目前的狀態，例如「Weichung 在附近」。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den aktuellen Status von Presence zurück, z. B. „iPhone in der Nähe“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns the current status of Presence, such as “iPhone nearby”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve el estado actual de Presence, como “iPhone cerca”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoie l’état actuel de Presence, par exemple « iPhone à proximité »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenceの現在の状態を返します。例：「iPhoneが近くにあります」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence의 현재 상태를 반환합니다(예: ‘iPhone 근처에 있음’)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Presence 当前的状态，例如“iPhone 在附近”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳 Presence 目前的狀態，例如「Weichung 在附近」。"
          }
        }
      }
    },
    "回到這裡，點「簡報遙控」": {
