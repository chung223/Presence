    "結束暫停，恢復自動鎖定與解鎖。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause beenden und automatisches Sperren und Entsperren fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the pause and resume automatic lock and unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la pausa y reanuda el bloqueo y desbloqueo automáticos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met fin à la suspension et reprend le verrouillage et le déverrouillage automatiques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止を終了し、自動ロックとロック解除を再開します。"
