    "%@ 一次付清，不會續訂": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ einmalig, keine Verlängerung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ once. No renewals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en un solo pago. Sin renovaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois, sans renouvellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を1回お支払い。自動更新はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 1회 결제, 자동 갱신 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性支付 %@，不会续期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 一次付清，不會續訂"
          }
        }
      }
    },
    "%@ 已恢復自動鎖定與解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat automatisches Sperren und Entsperren fortgesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resumed automatic lock and unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha reanudado el bloqueo y desbloqueo automáticos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : reprise du verrouillage et déverrouillage auto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の自動ロックとロック解除を再開しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 자동 잠금 및 잠금 해제 재개됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复自动锁定与解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢復自動鎖定與解鎖"
          }
        }
      }
    },
    "%@ 已暫停自動鎖定與解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat automatisches Sperren und Entsperren pausiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paused automatic lock and unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha pausado el bloqueo y desbloqueo automáticos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : verrouillage et déverrouillage auto suspendus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の自動ロックとロック解除を一時停止しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 자동 잠금 및 잠금 해제 일시 정지됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暂停自动锁定与解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暫停自動鎖定與解鎖"
          }
        }
      }
    },
    "%@ 已自動鎖定：你離開了": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde automatisch gesperrt, weil du gegangen bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ locked automatically because you left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha bloqueado automáticamente porque te has ido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est verrouillé automatiquement après votre départ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが離れたため、%@を自動でロックしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 자리를 떠나 자동으로 잠김"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自动锁定：你已离开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自動鎖定：你離開了"
          }
        }
      }
    },
