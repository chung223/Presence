          }
        }
      }
    },
    "%@：%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@：%2$@%3$@"
          }
        }
      }
    },
    "%@：最近 3 分鐘的訊號": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Signal in the Last 3 Minutes"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld dBm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dBm"
          }
        }
      }
    },
    "1 小時": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Hour"
          }
        }
      }
    },
    "15 分鐘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 Minutes"
          }
        }
      }
    },
    "4 小時": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4 Hours"
          }
        }
      }
    },
    "Apple Watch 請戴在手上。這個位置的訊號會用來決定解鎖門檻。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your Apple Watch. The signal here sets the unlock threshold."
          }
        }
      }
    },
    "Presence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence"
          }
        }
      }
    },
    "Presence 已啟動": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence started"
          }
        }
      }
    },
    "Presence 會先確認這是「%@」的登入密碼，再存進鑰匙圈。只有自動解鎖時才會讀出來，不會寫進任何紀錄。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence checks that this is the login password for “%@” before saving it to your keychain. It's read only when unlocking automatically and is never written to any log."
          }
        }
      }
    },
    "Presence 的想法來自 Takeshi Sone 的 BLEUnlock（MIT 授權），為新版 macOS 重新設計與實作。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is based on BLEUnlock by Takeshi Sone (MIT License), redesigned and rewritten for current macOS."
          }
        }
      }
    },
    "Presence 自動解鎖用的登入密碼": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login password Presence uses to unlock automatically"
          }
        }
      }
    },
    "Presence 還沒有啟動": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence isn't running"
          }
        }
      }
    },
    "RSSI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RSSI"
          }
        }
      }
    },
    "一般": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "不再監控 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped monitoring %@"
          }
        }
      }
    },
    "不在範圍內": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of range"
          }
        }
      }
    },
    "不在設定的時段": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside scheduled hours"
          }
        }
      }
    },
    "不在附近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Away"
          }
        }
      }
    },
    "不確定門檻要設多少？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure what thresholds to use?"
          }
        }
      }
    },
    "不自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-unlock off"
          }
        }
      }
    },
    "不自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock off"
          }
        }
      }
    },
    "主動模式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active mode"
          }
        }
      }
    },
    "主動模式會連線到裝置定期讀取訊號，數值比較穩定，但可能干擾藍牙鍵盤、滑鼠、耳機或個人熱點。被動模式只收廣播訊號，不會干擾其他設備。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active mode connects to your devices and reads their signal regularly. Readings are steadier, but it may interfere with Bluetooth keyboards, mice, headphones, or Personal Hotspot. Passive mode only listens to broadcasts and doesn't interfere with other devices."
          }
        }
      }
    },
    "事件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event"
          }
        }
      }
    },
    "事件腳本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event Script"
          }
        }
      }
    },
    "任一台在附近就算你在，全部都離開才會鎖定。例如同時加入 iPhone 和 Apple Watch，手錶訊號變弱時只要手機還在就不會鎖。每台裝置的門檻在「鎖定與解鎖」分開設定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You count as present when any of these devices is nearby, and your Mac locks only when all of them are away. For example, add both your iPhone and Apple Watch: if the watch signal drops, your Mac stays unlocked as long as your iPhone is nearby. Set each device's thresholds in Lock & Unlock."
          }
        }
      }
    },
    "例如只在上班時間自動鎖定。開始晚於結束表示跨過午夜，例如 22:00 到 06:00。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, lock automatically only during work hours. A start time later than the end time spans midnight, such as 22:00 to 06:00."
          }
        }
      }
    },
    "例如門口或隔壁座位。到了以後再按「開始測量」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Such as the door or the next desk. Click Start Measuring when you get there."
          }
        }
      }
    },
    "例如：家裡": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Home"
          }
        }
      }
    },
    "信任的網路": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted Networks"
          }
        }
      }
    },
    "儲存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      }
    },
    "允許使用藍牙": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth"
          }
        }
      }
    },
    "允許輔助使用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility"
          }
        }
      }
    },
    "允許通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Notifications"
          }
        }
      }
    },
    "兩個 App 同時執行會互相干擾。結束前，記得在舊版的選單關掉「登入時啟動」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running both apps at once causes conflicts. Before quitting BLEUnlock, turn off “Launch at Login” in its menu."
          }
        }
      }
    },
    "分鐘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        }
      }
    },
    "到「系統設定 › 隱私權與安全性 › 藍牙」打開 Presence。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Presence in System Settings › Privacy & Security › Bluetooth."
          }
        }
      }
    },
    "加入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "加入信任…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust…"
          }
        }
      }
    },
    "加入裝置後會在這裡顯示訊號": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a device to see its signal here"
          }
        }
      }
    },
    "匯入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        }
      }
    },
    "取得 Presence 狀態": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Presence Status"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "只在使用電池時自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock automatically only on battery power"
          }
        }
      }
    },
    "只在指定時段自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock automatically only during scheduled hours"
          }
        }
      }
    },
    "只設定解鎖門檻": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Unlock Threshold Only"
          }
        }
      }
    },
    "啟動": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        }
      }
    },
    "啟動螢幕保護程式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Screen Saver"
          }
        }
      }
    },
    "回來時自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock automatically when you return"
          }
        }
      }
    },
    "回傳目前的狀態，例如「Weichung 在附近 · -52 dBm」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns the current status, such as “iPhone nearby · -52 dBm”."
          }
        }
      }
    },
    "在 Finder 顯示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "在「%@」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On “%@”"
          }
        }
      }
    },
    "在任何 App 裡按下快捷鍵就會立即鎖定。「捷徑」App 裡也有 Presence 的動作（立即鎖定、暫停、恢復、取得狀態），可以接進自動化，或在終端機用 shortcuts run 執行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut in any app to lock right away. The Shortcuts app also has Presence actions (Lock Now, Pause, Resume, Get Status) for automations, or run them in Terminal with shortcuts run."
          }
        }
      }
    },
    "在指定的時間內不自動鎖定，也不自動解鎖。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't lock or unlock automatically for the specified time."
          }
        }
      }
    },
    "在這個位置放一個名為 event 的可執行檔，鎖定或解鎖時會帶參數執行：away（訊號變弱而鎖定）、lost（收不到訊號而鎖定）、unlocked（自動解鎖）、intruded（裝置不在時被手動解鎖）。第二個參數是當時的訊號強度。與 BLEUnlock 相容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put an executable named event here and it runs on lock and unlock with an argument: away (locked because the signal got weak), lost (locked because the signal was lost), unlocked (unlocked automatically), or intruded (unlocked manually while your devices were away). The second argument is the signal strength at that moment. Compatible with BLEUnlock."
          }
        }
      }
    },
    "在附近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby"
          }
        }
      }
    },
    "套用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        }
      }
    },
    "完全收不到訊號多久就鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock after no signal for"
          }
        }
      }
    },
