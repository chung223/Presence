    "10 秒後鎖定這台 Mac，動一下滑鼠或鍵盤可以取消": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac wird in 10 Sekunden gesperrt. Bewege die Maus oder drücke eine Taste, um abzubrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking this Mac in 10 seconds. Move the mouse or press a key to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac se bloqueará en 10 segundos. Mueve el ratón o pulsa una tecla para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac sera verrouillé dans 10 secondes. Bougez la souris ou appuyez sur une touche pour annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10秒後にこのMacをロックします。マウスかキーボードを操作するとキャンセルできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초 후에 이 Mac을 잠급니다. 취소하려면 마우스를 움직이거나 키를 누르세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒后锁定这台 Mac，移动鼠标或按任意键可取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒後鎖定這台 Mac，動一下滑鼠或鍵盤可以取消"
          }
        }
      }
    },
