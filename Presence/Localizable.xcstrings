    },
    "你不在時這台 Mac 被手動解鎖了，已拍下照片": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac wurde während deiner Abwesenheit manuell entsperrt. Es wurde ein Foto aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac was unlocked manually while you were away. A photo was taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien ha desbloqueado manualmente el Mac mientras no estabas. Se ha tomado una foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a été déverrouillé manuellement en votre absence. Une photo a été prise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不在中にこのMacが手動でロック解除されたため、写真を撮影しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자리에 없는 동안 이 Mac의 잠금이 수동으로 해제되어 사진을 찍었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不在时这台 Mac 被手动解锁，已拍下照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不在時這台 Mac 被手動解鎖了，已拍下照片"
          }
        }
      }
    },
