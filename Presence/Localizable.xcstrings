    "%@ 已離開，但偵測到你還在操作，暫緩鎖定": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist weg, aber du nutzt den Mac noch – Sperre aufgeschoben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left, but you're still using the Mac — lock postponed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fuera de alcance, pero sigues usando el Mac: bloqueo aplazado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est plus à proximité, mais vous utilisez encore le Mac — verrouillage différé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が離れましたが、操作中のためロックを保留しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 멀어졌지만 Mac을 사용 중이어서 잠금 보류"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已离开，但检测到你仍在操作，暂缓锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已離開，但偵測到你還在操作，暫緩鎖定"
          }
        }
      }
    },
