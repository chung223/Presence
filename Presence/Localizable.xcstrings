          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ 在附近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby"
          }
        }
      }
    },
    "%@ 在附近%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 在附近%2$@"
          }
        }
      }
    },
    "%@ 在附近，已自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby — unlocked automatically"
          }
        }
      }
    },
    "%@ 離開了，已自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left — locked automatically"
          }
        }
      }
    },
    "%@，不會自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — won't lock automatically"
