          }
        }
      }
    },
    "濾波後": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtered"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "濾波後"
          }
        }
      }
    },
    "灰點是每一筆收到的訊號，線是取中位數後的結果。線要高於綠色虛線才會解鎖，低於橘色虛線一段時間就會鎖定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gray dots are individual readings; the line is their median. Your Mac unlocks when the line is above the green dashed line, and locks when it stays below the orange one for a while."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "灰點是每一筆收到的訊號，線是取中位數後的結果。線要高於綠色虛線才會解鎖，低於橘色虛線一段時間就會鎖定。"
          }
        }
      }
    },
    "為這個網路取個名字": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
