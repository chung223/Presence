          }
        }
      }
    },
    "不在附近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Away"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不在附近"
          }
        }
      }
    },
    "不執行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不執行"
          }
        }
      }
    },
    "不確定門檻要設多少？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure what thresholds to use?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定門檻要設多少？"
          }
        }
      }
    },
    "不自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-unlock off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不自動解鎖"
          }
        }
      }
    },
    "不自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不自動鎖定"
          }
        }
      }
    },
    "主動模式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active mode"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主動模式"
          }
        }
      }
    },
    "主動模式會連線到裝置定期讀取訊號，數值比較穩定，但可能干擾藍牙鍵盤、滑鼠、耳機或個人熱點。被動模式只收廣播訊號，不會干擾其他設備。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active mode connects to your devices and reads their signal regularly. Readings are steadier, but it may interfere with Bluetooth keyboards, mice, headphones, or Personal Hotspot. Passive mode only listens to broadcasts and doesn't interfere with other devices."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主動模式會連線到裝置定期讀取訊號，數值比較穩定，但可能干擾藍牙鍵盤、滑鼠、耳機或個人熱點。被動模式只收廣播訊號，不會干擾其他設備。"
          }
        }
      }
    },
    "久坐提醒": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me to take breaks"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "久坐提醒"
          }
        }
      }
    },
    "之後可以從 iPhone 或 Apple Watch 控制這台 Mac。": {
      "localizations": {
        "en": {
          "stringUnit": {
