    "裝置不在時有人手動解鎖，就拍一張照片": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto aufnehmen, wenn jemand entsperrt, während meine Geräte weg sind"
