    "任一台在附近就算我在": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebiges Gerät in der Nähe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any device nearby"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo cerca"
          }
        },
        "fr": {
          "stringUnit": {
