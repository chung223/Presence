          }
        }
      }
    },
    "不再監控 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped monitoring %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
