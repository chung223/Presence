    "%@ 在附近，%@ 已加密確認，已自動解鎖": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in der Nähe, verschlüsselt bestätigt von %2$@ – automatisch entsperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nearby and confirmed by %2$@; unlocked automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cerca, confirmación cifrada de %2$@: desbloqueado automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à proximité, confirmation chiffrée de %2$@ — déverrouillage automatique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が近くにあり、%2$@で暗号化確認できたため、自動でロック解除しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 근처에 있음, %2$@에서 암호화 확인 완료, 자동으로 잠금 해제됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近，%2$@ 已完成加密确认，已自动解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近，%2$@ 已加密確認，已自動解鎖"
          }
        }
      }
    },
