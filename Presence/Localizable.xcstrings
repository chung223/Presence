          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode actif"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブモード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액티브 모드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主動模式"
          }
        }
      }
    },
    "主動模式會連線到裝置定期讀取訊號，數值比較穩定，但可能干擾藍牙鍵盤、滑鼠、耳機或個人熱點。被動模式只收廣播訊號，不會干擾其他設備。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im aktiven Modus verbindet sich Presence mit deinen Geräten und liest regelmäßig das Signal. Die Werte sind stabiler, können aber Bluetooth-Tastaturen, -Mäuse, -Kopfhörer oder den Persönlichen Hotspot stören. Der passive Modus empfängt nur Broadcasts und stört keine anderen Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active mode connects to your devices and reads their signal regularly. Readings are steadier, but it may interfere with Bluetooth keyboards, mice, headphones, or Personal Hotspot. Passive mode only listens to broadcasts and doesn't interfere with other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo activo se conecta a tus dispositivos y lee su señal con regularidad. Las lecturas son más estables, pero puede interferir con teclados, ratones o auriculares Bluetooth, o con el punto de acceso personal. El modo pasivo solo escucha las emisiones y no interfiere con otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode actif se connecte à vos appareils pour lire leur signal régulièrement. Les mesures sont plus stables, mais cela peut perturber les claviers, souris et écouteurs Bluetooth ou le Partage de connexion. Le mode passif écoute seulement les signaux diffusés et ne perturbe pas les autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブモードはデバイスに接続して定期的に信号を読み取るため、値が安定しますが、Bluetoothのキーボード、マウス、ヘッドフォン、インターネット共有に干渉することがあります。パッシブモードは発信されている信号を受信するだけなので、ほかの機器に干渉しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액티브 모드는 기기에 연결해 주기적으로 신호를 읽으므로 값이 더 안정적이지만, Bluetooth 키보드, 마우스, 헤드폰 또는 개인용 핫스팟을 방해할 수 있습니다. 패시브 모드는 브로드캐스트 신호만 수신하므로 다른 기기를 방해하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动模式会连接到设备并定期读取信号，数值较稳定，但可能干扰蓝牙键盘、鼠标、耳机或个人热点。被动模式只接收广播信号，不会干扰其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主動模式會連線到裝置定期讀取訊號，數值比較穩定，但可能干擾藍牙鍵盤、滑鼠、耳機或個人熱點。被動模式只收廣播訊號，不會干擾其他設備。"
          }
        }
      }
    },
