          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneは接続されていますが応答がありません。Presence Remoteをアップデートしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 연결되어 있지만 응답하지 않습니다. Presence Remote를 업데이트하세요"
          }
        },
        "zh-Hans": {
