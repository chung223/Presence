    "帶著%@走到你希望 Mac 開始鎖定的地方。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh mit %@ an die Stelle, ab der dein Mac sperren soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take %@ to where you want your Mac to lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva %@ hasta donde quieras que el Mac se bloquee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emportez %@ jusqu’à l’endroit où le Mac doit se verrouiller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を持って、Macをロックしたい場所まで移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 가지고 Mac이 잠기기를 원하는 위치로 이동하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带着%@走到你希望 Mac 开始锁定的地方。"
          }
        },
