{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ 在附近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在附近"
          }
        }
      }
    },
    "%@ 在附近%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近%2$@"
          }
        }
      }
    },
    "%@ 在附近，%@ 已加密確認，已自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nearby and confirmed by %2$@; unlocked automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在附近，%2$@ 已加密確認，已自動解鎖"
          }
        }
      }
    },
    "%@ 在附近，已喚醒螢幕": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby — display woken"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在附近，已喚醒螢幕"
          }
        }
      }
    },
    "%@ 在附近，已由 Apple Watch 或 Touch ID 解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby; unlocked with Apple Watch or Touch ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在附近，已由 Apple Watch 或 Touch ID 解鎖"
          }
        }
      }
    },
    "%@ 在附近，已自動解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nearby — unlocked automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在附近，已自動解鎖"
          }
        }
      }
    },
    "%@ 已加密確認（%lld 毫秒）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ confirmed (%2$lld ms)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加密確認（%2$lld 毫秒）"
          }
        }
      }
    },
    "%@ 已離開，但偵測到你還在操作，暫緩鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left, but you're still using the Mac — lock postponed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已離開，但偵測到你還在操作，暫緩鎖定"
          }
        }
      }
    },
    "%@ 離開了，已自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left — locked automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 離開了，已自動鎖定"
          }
        }
      }
    },
    "%@，不會自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — won't lock automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，不會自動鎖定"
          }
        }
      }
    },
    "%@，恢復自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — auto-lock resumed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，恢復自動鎖定"
          }
        }
      }
    },
    "%@，暫停自動鎖定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — auto-lock paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暫停自動鎖定"
          }
        }
      }
    },
    "%@，暫停自動鎖定與解鎖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — auto-lock and unlock paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暫停自動鎖定與解鎖"
          }
        }
      }
    },
    "%@：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        }
      }
    },
    "%@：%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@%3$@"
          }
        }
      }
    },
    "%@：最近 3 分鐘的訊號": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Signal in the Last 3 Minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：最近 3 分鐘的訊號"
          }
        }
      }
    },
    "%@：沒有訊號": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: No signal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：沒有訊號"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
